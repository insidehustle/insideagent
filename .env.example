# PostgreSQL / Neon / Supabase connection string
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require"
GROQ_API_KEY=""
GEMINI_API_KEY=""
TAVILY_API_KEY=""
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional: pollinations (free, no key) or gemini. Default: gemini if key set, falling back to pollinations
IMAGE_PROVIDER=
POLLINATIONS_API_KEY=

# Auto-research: /api/cron/research requires "Authorization: Bearer <this secret>". Vercel Cron sends it automatically.
CRON_SECRET=
# AUTO_RESEARCH_MAX_PER_RUN=3

# Google sign-in (https://console.cloud.google.com/apis/credentials -> OAuth client ID, type Web application).
# Authorized redirect URI: <NEXTAUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"
